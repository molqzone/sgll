# 从 sgll 目录运行 doxygen Doxyfile。Run doxygen Doxyfile from the sgll directory.
PROJECT_NAME           = SGLL
PROJECT_BRIEF          = "SG2002 C23 低层接口 / SG2002 C23 low-level interfaces"
OUTPUT_DIRECTORY       = build/doxygen
OUTPUT_LANGUAGE        = Chinese
INPUT_ENCODING         = UTF-8
INPUT                  = sgll.h inc src
FILE_PATTERNS          = *.h *.c
RECURSIVE              = YES
INCLUDE_PATH           = inc
OPTIMIZE_OUTPUT_FOR_C  = YES
MULTILINE_CPP_IS_BRIEF = YES
SORT_MEMBER_DOCS       = NO
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# 展示实际 C906L 接口并展开复位枚举。Expose C906L interfaces and expand reset enumerators.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED            = __riscv=1 __riscv_xlen=64
EXPAND_AS_DEFINED      = SG2002_RESET_MAP SG2002_RESET_ENUM

# 将遗漏或错误文档作为失败报告。Fail on missing or invalid documentation.
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
SOURCE_BROWSER         = YES
HAVE_DOT               = NO
